# Python & Umgebungen
venv/
.venv/
__pycache__/
*.pyc

# Konfiguration & Logs
.env
*.log
*.tmp
nohup.out

# Datenverzeichnisse & Deployments
data/
data_*/
deploy_*/
# Ingest-Logs
log_*.txt

# Benutzerdatei (enthaelt Passwort-Hashes) -- gehoert nie ins Repo
users.json
config/users.json
config/users.json.neu
config/tokens.json
config/tokens.json.neu

# Der Installationsschluessel. Mit ihm sind alle Chatverlaeufe lesbar und
# jede Signatur faelschbar -- er ist das eine Geheimnis, das auf keinen Fall
# in ein Repository geraet, auch nicht in ein privates.
config/schluessel.key
config/schluessel.key.neu

# Raeume samt Mitgliedschaften: kein Geheimnis, aber betriebsspezifisch.
# Im Repo wuerde ein Update die Zuordnungen ueberschreiben.
config/raeume.json
config/raeume.json.neu

# Zuordnung ownCloud-Ordner -> Raum. Kein Geheimnis, aber
# betriebsspezifisch -- im Repo wuerde ein Update sie
# ueberschreiben.
config/owncloud.json
config/owncloud.json.neu
!config/.gitkeep

# Standortspezifische Compose-Erweiterung (Netze, GPU, Ports)
docker-compose.override.yaml
docker-compose.override.yml

# Sicherungen des Bestands
*.tar
*.tar.gz
*.tgz
*.bak

# Sprachgebrauch des Betriebs. Die Vorlage ist glossar.example.txt; die
# gefuellte Datei bleibt lokal, damit ein Update die Eintraege nicht
# ueberschreibt -- dieselbe Aufteilung wie bei der .env.
glossar.txt
config/glossar.txt
config/presets/
config/tabellen_pfad.txt
config/tabellen_kopf.json
config/tabellen_kopf.json.neu
config/tabellen_pfad.txt.neu
config/*_prompt.txt
config/*_prompt.txt.neu
config/glossar.txt.neu

# Kennungen laufender Hintergrundvorgaenge
lauf_*.pid
