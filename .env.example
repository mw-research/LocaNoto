CONTAINER_NAME=locanoto_kunde
APP_PORT=8501
APP_TOPIC=Allgemein
COMPANY_NAME=Musterfirma
EXPERT_ROLE=technischer Assistent

# KI-Server Schnittstelle (z.B. lokaler Ollama oder vLLM Server)
OPENAI_API_KEY=sk-YourSecureKey
OPENAI_BASE_URL=http://192.168.X.X:4000

# Administrator-Accounts (Kommagetrennt, kleingeschrieben)
ADMIN_USERS=admin

# Modelle und Retrieval (optional, ueberschreiben die Defaults in der Sidebar)
CHAT_MODEL=qwen3.8:27b
EMBEDDING_MODEL=qwen3-embedding:4b

# Optional: eigenes, kleines Modell nur fuer die Chat-Benennung. Pro Frage
# laufen drei LLM-Aufrufe (Titel, Query-Rewrite, Antwort); der Titel ist eine
# Nebensache und muss nicht das grosse Modell beschaeftigen.
# TITLE_MODEL=qwen3:4b

# Wie viele Abschnitte in den Kontext gehen. 5 reicht bei dichten Regelwerken
# nicht: eine vollstaendige Toleranz-Auskunft braucht mehrere Tabellen aus
# mehreren Normen gleichzeitig.
TOP_K=12

# Obergrenze fuer einen Tabellen-Chunk in Zeichen. Ohne Grenze entstehen
# einzelne Chunks von ueber 60.000 Zeichen, deren Vektor unbrauchbar ist.
MAX_TABLE_CHARS=6000

# Zeitlimits in Sekunden (Default des Clients waere 600)
HELPER_TIMEOUT=60
ANSWER_TIMEOUT=300

# Reranker-Modell. Es wird beim "docker compose build" in das Image geladen
# und zur Laufzeit von dort gelesen -- kein Netzzugriff beim Start.
# Aenderst du den Namen, muss neu gebaut werden.
# Leer setzen ("") schaltet den Reranker ab; dann rankt allein die
# Rangfolge-Fusion, ohne Modell und ohne Ladezeit.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
