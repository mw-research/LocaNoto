CONTAINER_NAME=locanoto_kunde
APP_PORT=8501
APP_TOPIC=Allgemein
COMPANY_NAME=Musterfirma
EXPERT_ROLE=technischer Assistent

# KI-Server Schnittstelle (z.B. lokaler Ollama oder vLLM Server)
OPENAI_API_KEY=sk-YourSecureKey
OPENAI_BASE_URL=http://192.168.X.X:4000

# --- VERSCHLUESSELUNG UND ANMELDUNG ---
#
# Chatverlaeufe, angehaengte Bilder und das Rueckmeldungsprotokoll werden
# mit einem Installationsschluessel verschluesselt. Er entsteht beim ersten
# Start als config/schluessel.key (0600) -- ohne Zutun, ohne Eintrag hier.
#
# WICHTIG: dieser Schluessel gehoert in die Sicherung. Geht er verloren,
# sind alle Verlaeufe unlesbar, und zwar ohne Fehlermeldung -- die Dateien
# sind ja noch da. Wird er ersetzt, dasselbe.
#
# LOCANOTO_SCHLUESSEL setzt ihn stattdessen aus der Umgebung, etwa als
# Docker-Secret; dann liegt er nicht im Dateisystem. Base64, 32 Byte:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# LOCANOTO_SCHLUESSEL=

# Ausloggen nach dieser Zeit ohne Eingabe, in Minuten. 0 schaltet es ab --
# dann bleibt ein offener Browser an einem Arbeitsplatz angemeldet, bis
# jemand von Hand ausloggt.
# SITZUNG_MINUTEN=480

# Verwalter beim Umstieg. Gilt NUR, solange config/users.json noch aus der
# Zeit vor den Signaturen stammt. Danach steht die Rolle in der
# Benutzerdatei und ist mitsigniert -- eine Umgebungsvariable liesse sich
# am Container setzen, ohne die Benutzerdatei anzufassen, und waere damit
# ein Weg, sich Verwalterrechte zu geben.
ADMIN_USERS=admin

# --- MODELLE UND ENDPUNKTE ---
#
# Jede Aufgabe kann ihren eigenen Server bekommen. Nicht gesetzte Werte fallen
# auf OPENAI_BASE_URL und OPENAI_API_KEY oben zurueck -- wer alles ueber einen
# Endpunkt faehrt, laesst die Bloecke einfach leer.
#
# Je Aufgabe:
#   <AUFGABE>_MODEL        Modell- bzw. Deployment-Name
#   <AUFGABE>_BASE_URL     Adresse
#   <AUFGABE>_API_KEY      Schluessel
#   <AUFGABE>_API_VERSION  nur Azure OpenAI; gesetzt = Azure-Client

# Antwort und Umformulierung der Suchanfrage
CHAT_MODEL=qwen3.8:27b
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_API_VERSION=

# Vektorisierung von Chunks und Suchanfragen
EMBEDDING_MODEL=qwen3-embedding:8b
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Bildbeschreibung im Ingest
VISION_MODEL=qwen3-vl:32b

# Groessenfilter fuer Abbildungen. Kleiner als das gilt als Logo oder Symbol
# und wird uebersprungen. Die Vorgaben sind an technischen Zeichnungen
# kalibriert -- bei einem Software-Handbuch sind Bildschirmausschnitte
# deutlich kleiner, ein Dialogfenster misst schnell nur 250x260 Pixel.
# Dann heruntersetzen, etwa MIN_LONG_EDGE=200 und MIN_AREA=30000.
# MIN_LONG_EDGE=400
# MIN_AREA=120000

# Gleichzeitig laufende Anfragen an den Modellserver.
#
# Der Ingest wartet die meiste Zeit auf Antwort, nicht auf eigene Rechenzeit.
# Mehrere offene Anfragen lassen den Server sie zusammen abarbeiten und seine
# Grafikkarten auslasten -- die Beschleunigung entsteht dort, nicht hier.
# Die sinnvolle Obergrenze richtet sich nach dem Server; zu hohe Werte
# erzeugen dort nur eine Warteschlange. 1 stellt das serielle Verhalten her.
# VISION_PARALLEL=4
# EMBED_PARALLEL=2

# Wiederholungen bei voruebergehenden Ausfaellen des Sehmodell-Servers
# (nicht erreichbar, 504 vom vorgeschalteten Webserver, Zeitueberschreitung).
# Zwischen den Versuchen wird ansteigend gewartet.
# VISION_VERSUCHE=3
# VISION_WARTEN=5

# Zeitlimit je Bildanfrage in Sekunden. Ohne Angabe wartet der Client den
# Standard von 600 Sekunden ab -- bei einem nicht erreichbaren Server steht
# der Lauf damit zehn Minuten je Buendel still, ohne eine Zeile auszugeben.
# VISION_TIMEOUT=120
# VISION_BASE_URL=
# VISION_API_KEY=

# Wie oft der Bild-Ingest den Seitenfortschritt meldet. Ohne das meldet er
# sich nur, wenn ein Bild gefunden wird -- zwischen zwei Abbildungen koennen
# tausende Seiten liegen, und ein arbeitender Lauf sieht dann aus wie ein
# haengender. 0 schaltet die Meldung ab.
# SEITEN_MELDUNG=100

# Obergrenze fuer die Laenge einer Bildbeschreibung in Token. Ohne Angabe
# keine Grenze. Bei einem grossen Sehmodell macht die Erzeugung den
# Hauptteil der Zeit aus: gebraucht wird der lesbare Inhalt eines Bildes,
# nicht die Feststellung, dass der Hintergrund einheitlich weiss ist.
# VISION_MAX_TOKENS=600

# Bilder im Chat: laengste Kante, auf die ein hochgeladenes Bild vor dem
# Versand an das Sehmodell gebracht wird. Ein Bildschirmfoto kann mehrere
# Megabyte gross sein; groesser als dieser Wert bringt selten mehr
# Erkennung, belastet den Modellserver aber deutlich.
# CHAT_BILD_MAX_KANTE=1280

# Benennung des Chats. Pro Frage laufen drei LLM-Aufrufe (Titel,
# Umformulierung, Antwort); der Titel ist eine Nebensache und muss nicht das
# grosse Modell beschaeftigen. Leer = Chat-Modell.
# TITLE_MODEL=qwen3:4b
# TITLE_BASE_URL=
# TITLE_API_KEY=

# Beispiel -- Chat ueber Azure, alles andere lokal ueber Ollama:
#
#   OPENAI_BASE_URL=http://ollama:11434/v1
#   OPENAI_API_KEY=ollama
#   CHAT_MODEL=gpt-4o
#   CHAT_BASE_URL=https://meine-instanz.openai.azure.com
#   CHAT_API_KEY=...
#   CHAT_API_VERSION=2024-10-21

# Wie viele Abschnitte in den Kontext gehen. 5 reicht bei dichten Regelwerken
# nicht: eine vollstaendige Toleranz-Auskunft braucht mehrere Tabellen aus
# mehreren Normen gleichzeitig.
TOP_K=12

# Obergrenze fuer einen Tabellen-Chunk in Zeichen. Ohne Grenze entstehen
# einzelne Chunks von ueber 60.000 Zeichen, deren Vektor unbrauchbar ist.
#
# Der Wert richtet sich auch nach dem Kontextfenster des Embedding-Servers:
# Tabellen ergeben viel mehr Token je Zeichen als Fliesstext. Passt ein Chunk
# nicht, wird er fuer die Vektorberechnung gekuerzt -- gespeichert bleibt der
# volle Text. Zwei vollstaendig vektorisierte Haelften sind aber besser als
# eine Tabelle, deren Vektor nur den Anfang kennt.
MAX_TABLE_CHARS=3000

# Zeitlimit fuer das Vektorisieren der Suchsonden. Kuerzer als
# EMBED_TIMEOUT (das gilt dem Ingest): dort wartet niemand zu, hier sitzt
# ein Mensch vor einem Spinner. Laeuft es ab, nennt die Meldung den Grund.
#
# Bis zu diesem Stand kostete ein haengender Modellserver bei der Suche
# 120 s fuer den Sondenbatch und danach dreimal 120 s einzeln -- acht
# Minuten, bevor ueberhaupt eine Meldung erschien. Die Einzelnacharbeit
# gibt es bei der Suche nicht mehr; sie hilft nur bei zu langen Chunks im
# Ingest.
# SUCHE_EMBED_TIMEOUT=45

# Zeitlimits in Sekunden (Default des Clients waere 600)
HELPER_TIMEOUT=60
ANSWER_TIMEOUT=300

# --- RANGFOLGE DER TREFFER ---
#
# Drei Stufen, in dieser Reihenfolge:
#
#   1. Rerank-Endpunkt ueber HTTP. Damit laesst sich das Modell austauschen,
#      ohne das Image neu zu bauen -- lokal, bei einem Anbieter oder ueber
#      Azure. Erwartet wird das Cohere-artige Schema, das LiteLLM, Jina, TEI
#      und vLLM gleichermaszen sprechen.
#   2. Das Modell aus dem Image (siehe unten).
#   3. Keiner -- dann entscheidet allein die Rangfolge-Fusion.
#
# Stufe 1: leer lassen, wenn kein Endpunkt genutzt werden soll.
#
# RERANKER_API_MODEL ist der Name, unter dem das Modell AN DEINEM GATEWAY
# registriert ist -- nicht der Name des zugrundeliegenden Modells. Bei einem
# LiteLLM-Proxy heisst der Eintrag oft schlicht "rerank", waehrend dahinter
# etwa infinity/bge-reranker-v2-m3 steht. Ohne Angabe wird RERANKER_MODEL
# verwendet, was am Gateway in aller Regel nicht existiert.
#
# RERANKER_API_KEY faellt auf OPENAI_API_KEY zurueck, wenn es leer bleibt.
# RERANKER_BASE_URL dagegen nicht -- sie ist der Schalter fuer diese Stufe.
# RERANKER_BASE_URL=http://litellm:4000
# RERANKER_API_KEY=
# RERANKER_API_MODEL=rerank
# RERANKER_TIMEOUT=30

# Was gilt, wenn der Endpunkt gesetzt ist, aber gerade nicht antwortet.
#
#   fusion   Reihenfolge aus der Fusion behalten, Endpunkt spaeter erneut
#            versuchen. Voreinstellung.
#   image    Das CPU-Modell aus dem Image bewertet stattdessen.
#
# Warum "fusion": das CPU-Modell braucht fuer die 36 Kandidaten einer Frage
# ein bis zwei Minuten -- fuer den Nutzer nicht von einem Haenger zu
# unterscheiden. Ein GPU-Server, der Modelle nach fuenf Minuten Ruhe
# entlaedt, faellt jeden Morgen einmal aus; das darf nicht den Tag kosten.
# RERANKER_RUECKFALL=fusion

# Nach wie vielen Sekunden ein ausgefallener Endpunkt erneut versucht wird.
# RERANKER_ERNEUT=60

# --- GEHOSTETER RERANK-DIENST ---
#
# Statt eines eigenen Endpunkts geht auch ein Anbieter. Erwartet wird das
# Cohere-artige Schema (query + documents rein, Treffer mit index und
# relevance_score raus); das sprechen alle folgenden.
#
#   Cohere      RERANKER_BASE_URL=https://api.cohere.com/v2/rerank
#               RERANKER_API_MODEL=rerank-v3.5
#
#   Jina        RERANKER_BASE_URL=https://api.jina.ai/v1/rerank
#               RERANKER_API_MODEL=jina-reranker-v2-base-multilingual
#
#   Voyage      RERANKER_BASE_URL=https://api.voyageai.com/v1/rerank
#               RERANKER_API_MODEL=rerank-2
#
#   Together    RERANKER_BASE_URL=https://api.together.xyz/v1/rerank
#               RERANKER_API_MODEL=Salesforce/Llama-Rank-V1
#
#   Mixedbread  RERANKER_BASE_URL=https://api.mixedbread.ai/v1/reranking
#               RERANKER_API_MODEL=mxbai-rerank-large-v2
#
# Die Modellnamen aendern sich; die Adresse ist der Teil, auf den es
# ankommt. Endet sie nicht auf /rerank, wird es angehaengt -- eine Wurzel
# wie https://api.cohere.com/v2 genuegt also auch.
#
# ZWEI DINGE, DIE SONST STILL SCHIEFGEHEN:
#
# 1. RERANKER_API_KEY ausdruecklich setzen. Der Rueckfall auf
#    OPENAI_API_KEY greift NUR, wenn der Rerank-Endpunkt auf denselben
#    Wirt zeigt wie OPENAI_BASE_URL. Ein gehosteter Dienst bekommt den
#    Schluessel des eigenen Gateways also nicht -- er bekommt dann gar
#    keinen, und die Anfrage scheitert mit 401. Das ist Absicht: ein
#    Schluessel, der einmal bei einem fremden Dienst angekommen ist,
#    laesst sich nicht zurueckholen.
#
# 2. Fuer deutsche Fachdokumente ein MEHRSPRACHIGES Modell nehmen. Ein
#    rein englisches bewertet deutsche Abschnitte scheinbar plausibel und
#    stellt die Rangfolge trotzdem falsch -- ein Fehler, der nicht
#    auffaellt, weil eine Antwort ja kommt.
#
# Die Abschnitte gehen dabei an den Anbieter. Fuer eine Installation,
# deren Zweck "alles bleibt im Haus" ist, ist das die Umkehrung der
# Voraussetzung -- fuer eine Ueberbrueckung, bis der eigene Dienst wieder
# laeuft, kann es die richtige Entscheidung sein. Sie gehoert dir.

# Stufe 2: wird beim "docker compose build" in das Image geladen und zur
# Laufzeit von dort gelesen -- kein Netzzugriff beim Start. Aenderst du den
# Namen, muss neu gebaut werden. Leer setzen ("") laesst diese Stufe aus.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#
# Ausschalten heisst: die Zeile LEER lassen (RERANKER_MODEL=). Das wirkt
# seit diesem Stand auch wirklich -- vorher setzte die docker-compose.yaml
# mit ${RERANKER_MODEL:-...} den Standard auch fuer einen leeren Wert
# wieder ein, und der Ausschalter tat nichts.

# Versuche des Model-Clients je Anfrage. Der OpenAI-Client wiederholt eine
# fehlgeschlagene Anfrage von sich aus zweimal -- ein gesetztes Zeitlimit
# waere damit nur ein Drittel der tatsaechlichen Wartezeit, und die eigenen
# Wiederholungen der Skripte kaemen obendrauf. Voreingestellt ist deshalb
# ein Versuch.
# LLM_VERSUCHE=1

# --- LISTEN (Tabellendateien) ---
# xlsx und csv unter data/tabellen/ werden nicht vektorisiert. Ein Katalog
# haelt ihre Struktur; die Zeilen liest die Anwendung bei jeder Frage frisch
# aus der Datei. Geaenderte Zeilen wirken damit sofort, nur bei neuen
# Dateien oder neuen Spalten muss der Katalog neu eingelesen werden.
#
# Ort der Listen. Ohne Angabe data/tabellen/ im Datenverzeichnis.
#
# Zeigt auf ein eingehaengtes Verzeichnis, wenn die Listen im Netzlaufwerk
# der Firma liegen und dort gepflegt werden -- dann muss sie niemand
# zweimal ablegen. In der docker-compose.override.yaml dazu:
#
#   services:
#     locanoto_bot:
#       volumes:
#         - /mnt/firma/listen:/listen:ro
#
# und hier TABELLEN_PFAD=/listen. Nur-Lese-Einhaengung genuegt, die
# Anwendung schreibt dort nicht hinein.
# TABELLEN_PFAD=

# Ab dieser Zeilenzahl gilt ein Blatt als gross. Solche Blaetter stehen im
# Katalog, werden aber nur abgefragt, wenn der Nutzer sie ausdruecklich
# einbezieht -- das Laden dauert dann spuerbar.
# TABELLEN_GROSS_AB=50000

# Wie viele Zeilen nach der Kopfzeile abgesucht werden. Echte Tabellen
# fangen selten in Zeile 1 an -- darueber stehen ein Titel, ein
# Ausdruckdatum, eine Leerzeile.
# TABELLEN_KOPF_SUCHEN=15

# Obergrenze fuer zurueckgelieferte Zeilen je Abfrage.
# TABELLEN_MAX_ZEILEN=200

# Beispielwerte im Katalog: bis zu wie vielen verschiedenen Werten eine
# Spalte aufgezaehlt wird, und wie viele davon in den Prompt kommen. Sie
# sagen mehr ueber den Inhalt als jeder Spaltenname -- und sind zugleich
# der einzige Teil des Katalogs, der echte Daten an das Modell traegt.
# TABELLEN_BEISPIELE_BIS=25
# TABELLEN_BEISPIELE=12

# Obergrenze fuer den Katalog im Prompt.
# TABELLEN_KATALOG_MAX_CHARS=12000

# Schalter in der Seitenleiste beim Laden vorbelegen.
# TABELLEN_DEFAULT_ON=1

# --- VEKTORDATENBANK ---
# Ohne Angabe liegt der Bestand als Dateiablage unter data/chroma_db --
# richtig, solange nur ein Prozess darauf zugreift.
#
# Sobald die Schnittstelle mitlaeuft, sind es zwei Prozesse, und dafuer ist
# die Dateiablage nicht gebaut: die Folge waere kein sauberer Fehler,
# sondern ein beschaedigter Index. CHROMA_HOST=chroma schaltet Oberflaeche,
# Skripte und Schnittstelle auf den chroma-Dienst aus der
# docker-compose.yaml um. Der liest denselben Ordner weiter -- die Daten
# muessen nicht umgezogen werden.
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# --- DATENBANK BEIM ANBIETER ---
# Nur noetig, wenn der Chroma-Server NICHT im selben Docker-Netz steht.
#
# Ein erreichbarer Chroma-Server ohne Token ist offen: er kennt keine
# Nutzer, und wer ihn erreicht, darf alles -- auch Sammlungen loeschen.
# Solange er neben der Anwendung im Docker-Netz laeuft, deckt das Netz ihn
# ab. Sobald er darueber hinaus erreichbar ist, ist der Token nicht
# optional.
# CHROMA_SSL=1
# CHROMA_TOKEN=
# CHROMA_TOKEN_HEADER=X-Chroma-Token

# Gehostetes Chroma. Setzt CHROMA_HOST ausser Kraft: dort treten Mandant
# und Datenbank an die Stelle von Wirt und Port.
#
# Zu bedenken, bevor man das setzt: der Bestand liegt dann nicht mehr beim
# Betreiber. Fuer eine Installation, deren Zweck "alles bleibt im Haus"
# ist, ist das die Umkehrung der Voraussetzung.
# CHROMA_CLOUD_KEY=
# CHROMA_CLOUD_TENANT=
# CHROMA_CLOUD_DATABASE=locanoto

# --- SPEICHERORTE ---
#
# Nichts, was nicht der Container selbst ist, soll im Container liegen. Drei
# Wurzeln, weil sie verschiedene Anforderungen haben.
#
# ACHTUNG auf die Seite: DATEN_PFAD und KONFIG_PFAD sind Pfade auf dem
# HOST -- sie sagen, was eingehaengt wird. LOCANOTO_INDEX ist ein Pfad IM
# CONTAINER. Verwechselt man das, laeuft alles, nur am falschen Ort.
#
# 1. Nutzerdaten und Quellen: Dokumente, Chats, Rueckmeldungen, Protokolle.
#    Der Bestand, der einen neuen Container ueberleben muss. Netzspeicher
#    ist hier richtig -- es sind gewoehnliche Dateien.
# DATEN_PFAD=/mnt/cluster/locanoto/daten

# 2. Konfiguration: Nutzer, Token, Schluessel, Raeume, Prompts. Ebenfalls
#    persistent, aber GETRENNT: hier liegt der Schluessel, mit dem alle
#    Chatverlaeufe lesbar sind, und eine Sicherung der Dokumente soll ihn
#    nicht mitnehmen. Andere Rechte, andere Aufbewahrung.
# KONFIG_PFAD=/mnt/cluster/locanoto/konfig

# 3. Die Datenbanken: Vektordatenbank, Stichwortindex, Listenkatalog,
#    Kennungen laufender Prozesse.
#
#    PERSISTENT ja -- aber NICHT auf einer Dateifreigabe. Das ist die
#    Unterscheidung, an der es beim Aufsetzen am haeufigsten scheitert:
#
#      Blockspeicher (Ceph RBD, iSCSI, EBS, local PV, eine angeschlossene
#      Platte) traegt ein ext4 oder xfs. Darauf laeuft SQLite einwandfrei,
#      und genau dorthin gehoert dieses Verzeichnis.
#
#      Eine Freigabe ueber NFS oder SMB traegt es nicht: SQLite braucht im
#      WAL-Betrieb gemeinsamen Speicher im selben Dateisystem, den es dort
#      nicht gibt, und die Dateisperren sind unzuverlaessig. Das Ergebnis
#      ist kein Fehler, sondern ein beschaedigter Index -- und SQLite
#      faellt dabei STILL auf einen anderen Journalmodus zurueck. Die
#      Oberflaeche liest ihn zurueck und meldet es unter "Speicherorte".
#
#    In den Container gehoert es auch nicht: dessen Schreibschicht
#    ueberlebt einen Neustart nicht. Bei docker compose liegt deshalb ein
#    benanntes Volume auf /var/lib/locanoto, in Kubernetes ein
#    PersistentVolume mit ReadWriteOnce (siehe k8s/).
#
#    Zwei Dinge muessen zusammenkommen: ein echtes Dateisystem, und genau
#    ein schreibender Prozess. Deshalb laeuft die Vektordatenbank ab hier
#    als eigener Dienst (CHROMA_HOST) mit eigenem Volume -- dann
#    entscheidet sie selbst, wer schreibt, statt dass es der Zufall tut.
#
#    Ohne Angabe bleibt alles unter /app/data, also so wie bisher.
# LOCANOTO_INDEX=/var/lib/locanoto

# --- DOKUMENTE AUS OWNCLOUD ODER NEXTCLOUD ---
#
# Ein Ordner in der Cloud wird auf einen Raum abgebildet; die Zuordnung
# steht in config/owncloud.json und wird in der Oberflaeche gepflegt.
# Unterordner darin werden zu Sachgebieten.
#
# Damit liegen die Dokumente dort, wo sie ohnehin gepflegt werden, und die
# Rechte auf dem Ordner sind die von ownCloud. Die Mitgliedschaft des Raums
# entscheidet dann, wer die daraus gebauten Abschnitte sieht.
#
# OWNCLOUD_URL ist die Wurzel der Installation, nicht der WebDAV-Pfad.
# Bei aktiver Zwei-Faktor-Anmeldung braucht es ein APP-PASSWORT, nicht das
# Anmeldepasswort. Ein Lesezugriff genuegt -- die Anwendung schreibt nie
# nach ownCloud zurueck.
# OWNCLOUD_URL=https://cloud.firma.de
# OWNCLOUD_USER=locanoto
# OWNCLOUD_PASSWORT=
# OWNCLOUD_TIMEOUT=30

# --- MITGLIEDSCHAFT AUS OWNCLOUD-GRUPPEN ---
#
# Wer die Abschnitte eines Raums sehen darf, kann aus einer
# ownCloud-Gruppe kommen statt aus config/raeume.json. Eingetragen wird die
# Gruppe am Raum selbst -- in der Oberflaeche unter "Raeume verwalten".
#
# Die Mitglieder der Gruppe kommen zu den von Hand eingetragenen HINZU, sie
# ersetzen sie nicht: ein Verwalter, den die Firma nicht in der
# Abteilungsgruppe fuehrt, soll sich nicht selbst aussperren.
#
# Die Gruppenabfrage laeuft ueber die Provisioning-Schnittstelle und
# verlangt dort ein Konto mit VERWALTERRECHTEN -- fuer das Holen der
# Dateien genuegt Lesen. Ohne diese beiden Werte wird das Konto von oben
# benutzt, das dann Verwalter sein muss.
# OWNCLOUD_ADMIN_USER=
# OWNCLOUD_ADMIN_PASSWORT=

# Gelesen wird ein Zwischenspeicher, nicht ownCloud selbst: eine
# HTTP-Anfrage je Frage waere ein Rundlauf je Sonde, und bei nicht
# erreichbarem ownCloud stuende die Suche. Der Preis ist Aktualitaet -- wer
# aus einer Gruppe entfernt wird, kommt bis zum naechsten Abgleich noch
# hinein.
#
# Ab diesem Alter in Minuten gilt der Stand nicht mehr, und die
# Gruppenmitgliedschaften fallen weg, bis wieder abgeglichen wurde. 0
# heisst: kein Hoechstalter.
#
# Eine Abwaegung ohne richtige Antwort, und sie gehoert dir: verfaellt der
# Stand, sperrt ein nicht erreichbares ownCloud alle aus ihren
# Abteilungsraeumen aus. Verfaellt er nicht, behaelt ein ausgeschiedener
# Mitarbeiter seinen Zugang bis zum naechsten Abgleich. Von Hand
# eingetragene Mitglieder und der eigene Raum sind davon nie betroffen.
# OWNCLOUD_GRUPPEN_HOECHSTALTER=0

# Der Abgleich laeuft ueber die Oberflaeche (abgekoppelt) oder als Skript.
# Fuer den Dauerbetrieb in einen Zeitplan auf dem Server:
#
#   0 3 * * *  docker compose exec -T locanoto_bot python abgleich.py
#
# Zum Pruefen ohne Nebenwirkung: python abgleich.py --pruefen
# Nur die Mitgliedschaften: python abgleich.py --nur-gruppen

# Nur einen Unterordner einlesen. Setzt abgleich.py selbst je Raum; von
# Hand gebraucht, wenn ein einzelnes Sachgebiet neu eingelesen werden soll.
# INGEST_ORDNER=

# --- SICHERUNG DER VEKTORDATENBANK ---
#
# Die Vektordatenbank ist der einzige Zustand, der NICHT ableitbar ist und
# trotzdem nicht auf den Netzspeicher gehoert: SQLite plus binaere
# Indexdateien. Ginge sie verloren, waere die Wiederherstellung ein
# vollstaendiges Neueinlesen -- Stunden Modellzeit fuer ein Ergebnis, das
# schon vorlag.
#
# Also: der laufende Bestand auf lokalem oder Blockspeicher (LOCANOTO_INDEX)
# und ein Abzug davon auf dem persistenten Speicher. Der Abzug enthaelt die
# Vektoren, ein Einspielen braucht deshalb kein Modell und keinen Endpunkt.
#
# Gemessen an 20.500 Abschnitten mit Dimension 1024: Sichern 2,6 s und
# 112 MB, Einspielen 29 s. Hochgerechnet auf 324.000 Abschnitte rund 40 s
# und 1,8 GB, Einspielen etwa acht Minuten. Das Einspielen dauert laenger,
# weil der Suchindex dabei neu gebaut wird.
#
# Ohne Angabe unter <LOCANOTO_DATEN>/sicherungen. Ein eigenes Laufwerk ist
# besser -- ein Abzug, der neben den Daten liegt, teilt ihr Schicksal.
# SICHERUNG_PFAD=/mnt/sicherung/locanoto

# Wie viele Abzuege behalten werden. 0 heisst: alle.
# SICHERUNG_BEHALTEN=7

# Der Abzug laeuft ueber die Oberflaeche (abgekoppelt) oder als Skript:
#
#   docker compose exec locanoto_bot python sicherung.py
#   docker compose exec locanoto_bot python sicherung.py liste
#   docker compose exec locanoto_bot python sicherung.py zurueck NAME
#
# Fuer den Dauerbetrieb in einen Zeitplan, nach dem naechtlichen Abgleich:
#
#   0 4 * * *  docker compose exec -T locanoto_bot python sicherung.py

# --- PERSOENLICHE RAEUME ---
#
# Jeder Nutzer bekommt mit seinem Zugang einen eigenen Raum. Niemand sonst
# sieht dessen Dateien -- weder in der Suche noch in einer Antwort.
#
# PRIVAT_STRENG=1 geht einen Schritt weiter: dann erfaehrt auch ein
# Verwalter nichts ueber fremde persoenliche Raeume, nicht einmal die
# Dateinamen. Denn ein Dateiname ist eine Auskunft --
# "Angebot_Kunde_Meier_2026.pdf" verraet den Vorgang, ohne dass jemand die
# Datei oeffnet. Fuer Branchen, in denen "jeder weiss nur, was er wissen
# muss" gilt, ist das der richtige Betrieb.
#
# Was einem Verwalter dann bleibt: er sieht, DASS ein Raum Inhalt hat, und
# kann ihn als Ganzes leeren -- ein Loeschrecht ohne Leserecht. Fuer eine
# verwaiste Ablage eines ausgeschiedenen Mitarbeiters genuegt das.
#
# Ausgeschaltet bleibt es die Voreinstellung, weil ein Verwalter beim
# Aufraeumen sonst blind arbeitet.
# PRIVAT_STRENG=0

# --- RAEUME ---
# In welchen Raum ingest.py und ingest_images.py einlesen. Ohne Angabe in
# den allgemeinen Raum -- den Bestand, den alle sehen.
#
# Ein anderer Raum ist der Weg, einen Abteilungsbestand einzulesen, ohne
# ihn vorher fuer alle sichtbar zu machen. Der Raum muss vorher in der
# Oberflaeche angelegt sein, sonst sieht ihn niemand.
# INGEST_RAUM=allgemein

# Wie viele Rueckmeldungen die Seitenleiste je Abschnitt zeigt. Das
# Protokoll in data/feedback.jsonl waechst unabhaengig davon weiter.
# FEEDBACK_ANZEIGE=50

# --- SCHNITTSTELLE ---
# Port, unter dem die HTTP-Schnittstelle auf dem Server erreichbar ist. Sie
# wird an 127.0.0.1 gebunden, also nicht ins Netz veroeffentlicht: der
# Verkehr ist unverschluesselt, und das Token waere sonst auf dem Draht
# mitlesbar. Von aussen erreichbar machen heisst: Reverse Proxy mit TLS
# davor.
#
# Zugang ueber Token, angelegt mit create_token.py. Ohne Token kein Zugriff.
# API_PORT=8600

# --- BUILD ---
# Der Xet-Uebertragungsweg von HuggingFace bleibt gelegentlich haengen. Auf 1
# laeuft der Download des Reranker-Modells beim Bauen ueber HTTPS.
HF_HUB_DISABLE_XET=1
